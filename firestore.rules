rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }

    // Dados da escola (cabeçalho das folhas), um por professor
    match /gab_perfis/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Turmas, avaliações e notas: cada professor só vê e altera o que é dele
    match /{col}/{id} {
      allow read, delete: if logado() && col in ['gab_turmas', 'gab_avaliacoes', 'gab_resultados']
                          && resource.data.dono == request.auth.uid;
      allow create: if logado() && col in ['gab_turmas', 'gab_avaliacoes', 'gab_resultados']
                    && request.resource.data.dono == request.auth.uid;
      allow update: if logado() && col in ['gab_turmas', 'gab_avaliacoes', 'gab_resultados']
                    && resource.data.dono == request.auth.uid
                    && request.resource.data.dono == request.auth.uid;
    }
  }
}
