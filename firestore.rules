rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }

    // Dados da escola (cabeçalho das folhas), um por professor
    match /gab_perfis/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Turmas, avaliações, notas e timbrados (todas as coleções gab_…):
    // cada professor só vê e altera o que é dele
    match /{col}/{id} {
      allow read, delete: if logado() && col.matches('gab_.*') && col != 'gab_perfis'
                          && resource.data.dono == request.auth.uid;
      allow create: if logado() && col.matches('gab_.*') && col != 'gab_perfis'
                    && request.resource.data.dono == request.auth.uid;
      allow update: if logado() && col.matches('gab_.*') && col != 'gab_perfis'
                    && resource.data.dono == request.auth.uid
                    && request.resource.data.dono == request.auth.uid;
    }
  }
}
